{
  "name": "unmyeong-comment-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "doctor": "tsx scripts/doctor.ts",
    "drafts:check": "tsx scripts/drafts.ts check",
    "drafts:refresh": "tsx scripts/drafts.ts refresh",
    "evidence:collect": "node --import tsx scripts/collect-evidence.ts",
    "profile:open": "tsx scripts/profile.ts",
    "test-video:add": "tsx scripts/test-video.ts",
    "release:check": "tsx scripts/release-check.ts",
    "test:draft": "tsx scripts/prepare-test.ts",
    "package:submission": "tsx scripts/package.ts",
    "format": "prettier --write src scripts tests *.ts *.json",
    "format:check": "prettier --check src scripts tests *.ts *.json",
    "record:install": "PLAYWRIGHT_BROWSERS_PATH=.local/playwright playwright install ffmpeg",
    "record:tour": "tsx scripts/walkthrough.ts",
    "observation:report": "tsx scripts/observation-report.ts",
    "secrets:check": "tsx scripts/secrets-check.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.4"
  }
}
